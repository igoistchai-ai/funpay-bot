# Telegram bot token used for /start, key delivery, and Telegram Stars payments
TELEGRAM_BOT_TOKEN=123456789:replace_with_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username

# Telegram MTProto API credentials from https://my.telegram.org
# DEMO VALUES ONLY — replace both with real values from https://my.telegram.org
TELEGRAM_API_ID=28473195
TELEGRAM_API_HASH=9f4c2a7b1d8e6035a9c4f217b6e0831d

# OpenAI API key for AI drafts and per-chat automatic replies
OPENAI_API_KEY=sk-replace_me
OPENAI_MODEL=gpt-4.1-mini

# Dashboard admin access; alternatively use ADMIN_TELEGRAM_ID to enter through Telegram WebApp
DASHBOARD_PASSWORD=replace_with_a_long_admin_password
ADMIN_TELEGRAM_ID=8357023784

# Keep this stable between deployments so saved Telegram sessions can be decrypted
SESSION_SECRET=replace_with_a_long_random_secret

# Render provides PORT and RENDER_EXTERNAL_URL automatically
# PORT=8000
# RENDER_EXTERNAL_URL=https://your-service.onrender.com
# DATA_DIR=/var/data
